<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F4F6F9">

    <!-- MỚI: Nút quay lại đặt ngay đầu màn hình, không cần cuộn xuống mới thấy -->
    <Button
        android:id="@+id/btnBackLogs"
        android:layout_width="wrap_content"
        android:layout_height="42dp"
        android:text="← Back"
        android:textAllCaps="false"
        android:backgroundTint="#555555"
        android:textColor="#FFFFFF"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📜 WMS WAREHOUSE ACTIVITY LOG"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#F39C12"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <EditText
            android:id="@+id/edtSearchLog"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:hint="Enter code (e.g.: 60001)..."
            android:inputType="number"
            android:background="@android:drawable/edit_text"
            android:padding="10dp" />

        <Button
            android:id="@+id/btnSearchLog"
            android:layout_width="wrap_content"
            android:layout_height="45dp"
            android:text="🔍 SEARCH"
            android:backgroundTint="#3498DB"
            android:textColor="#FFFFFF"
            android:layout_marginLeft="8dp"/>
    </LinearLayout>

    <ListView
        android:id="@+id/listViewLogs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#CCCCCC"
        android:dividerHeight="1dp"
        android:layout_marginBottom="8dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTabOverview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📦 OVERVIEW"
            android:backgroundTint="#7F8C8D"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginRight="4dp"/>

        <Button
            android:id="@+id/btnTabLogs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📜 WAREHOUSE LOG"
            android:backgroundTint="#0084FF"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>

</LinearLayout>