<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <EditText
            android:id="@+id/edtDriverName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tên tài xế"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/edtTruckPlate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Biển số xe (VD: 29C-123.45)"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnStartLog"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="BẮT ĐẦU CHUYẾN ĐI (BẬT GPS)"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnStopLog"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="KẾT THÚC CHUYẾN ĐI"
            android:backgroundTint="#F44336"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tọa độ GPS hiện tại nhận được:"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/txtLiveGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Vĩ độ (Lat): ---\nKinh độ (Lng): ---"
            android:background="#EEEEEE"
            android:padding="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"
            android:textSize="16sp"
            android:fontFamily="monospace"/>

        <!-- ============ DANH SÁCH CHUYẾN HÀNG ĐANG GIAO CỦA XE NÀY ============ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="15dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Chuyến hàng đang giao (SHIPPING)"
                android:textStyle="bold"
                android:textSize="17sp"/>

            <Button
                android:id="@+id/btnRefreshTrips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tải lại"
                android:backgroundTint="#2196F3"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtTripEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chưa có chuyến nào. Hãy bấm 'Bắt đầu chuyến đi' hoặc 'Tải lại' sau khi được phòng TMS điều xe."
            android:textColor="#999999"
            android:padding="10dp"/>

        <LinearLayout
            android:id="@+id/llTripList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>
</ScrollView>