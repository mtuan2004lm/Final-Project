<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ============ THANH TRÊN: TIÊU ĐỀ + NÚT ĐĂNG XUẤT ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="15dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TMS DRIVER"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="#2c3e50"/>

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚪 Log Out"
                android:textSize="12sp"
                android:backgroundTint="#c0392b"/>
        </LinearLayout>

        <EditText
            android:id="@+id/edtDriverName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Driver name"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/edtTruckPlate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="License plate (e.g.: 29C-123.45)"
            android:layout_marginBottom="20dp"/>

        <Button
            android:id="@+id/btnStartLog"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="START TRIP (ENABLE GPS)"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnStopLog"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="END TRIP"
            android:backgroundTint="#F44336"
            android:layout_marginBottom="30dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Current GPS coordinates received:"
            android:textStyle="bold"
            android:textSize="16sp"/>

        <TextView
            android:id="@+id/txtLiveGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Latitude (Lat): ---\nLongitude (Lng): ---"
            android:background="#EEEEEE"
            android:padding="15dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="30dp"
            android:textSize="16sp"
            android:fontFamily="monospace"/>

        <!-- ============ DANH SÁCH CHUYẾN HÀNG ĐANG GIAO CỦA XE NÀY ============ -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="15dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Trips in delivery (SHIPPING)"
                android:textStyle="bold"
                android:textSize="17sp"/>

            <Button
                android:id="@+id/btnRefreshTrips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reload"
                android:backgroundTint="#2196F3"/>
        </LinearLayout>

        <TextView
            android:id="@+id/txtTripEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No trips yet. Press 'Start Trip' or 'Reload' after being dispatched by the TMS department."
            android:textColor="#999999"
            android:padding="10dp"/>

        <LinearLayout
            android:id="@+id/llTripList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>
</ScrollView>