<?xml version="1.0" encoding="utf-8"?>
<!-- Đặt file này trong res/layout/. Dùng làm 1 dòng trong danh sách chuyến hàng của tài xế -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#F5F5F5"
    android:padding="14dp"
    android:layout_marginBottom="10dp">

    <TextView
        android:id="@+id/txtTripTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="#2c3e50"/>

    <TextView
        android:id="@+id/txtTripRoute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="13sp"
        android:textColor="#2e7d32"
        android:layout_marginTop="4dp"/>

    <TextView
        android:id="@+id/txtTripStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="#7f8c8d"
        android:layout_marginTop="2dp"/>

    <Button
        android:id="@+id/btnTripDetail"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="Chi tiết chuyến &amp; Nộp E-POD"
        android:backgroundTint="#2ecc71"
        android:layout_marginTop="8dp"/>

</LinearLayout>