<?xml version="1.0" encoding="utf-8"?>
<!-- Đặt file này trong res/layout/ -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRIP DETAILS"
            android:textStyle="bold"
            android:textSize="20sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:id="@+id/txtDetailOrderId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="#2c3e50"/>

        <TextView
            android:id="@+id/txtDetailCustomer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtDetailProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtDetailRoute"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#2e7d32"
            android:textSize="14sp"/>

        <TextView
            android:id="@+id/txtDetailTruck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="20dp"
            android:textSize="14sp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#DDDDDD"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter road expenses incurred (USD)"
            android:textStyle="bold"
            android:textSize="15sp"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/edtBotFee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="BOT Toll Fee (USD)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/edtFuelFee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fuel / Gas Cost (USD)"
            android:inputType="numberDecimal"
            android:layout_marginBottom="10dp"/>

        <EditText
            android:id="@+id/edtDriverNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Driver notes..."
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GPS coordinates attached to the report:"
            android:textStyle="bold"
            android:textSize="13sp"/>

        <TextView
            android:id="@+id/txtDetailGps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#EEEEEE"
            android:padding="12dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="24dp"
            android:fontFamily="monospace"/>

        <Button
            android:id="@+id/btnSubmitPod"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="📸 SIGN &amp; SEND TO ACCOUNTING (E-POD)"
            android:backgroundTint="#2ecc71"/>

    </LinearLayout>
</ScrollView>