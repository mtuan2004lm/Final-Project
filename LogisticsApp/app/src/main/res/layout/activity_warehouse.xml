<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="16dp"
    android:paddingRight="16dp"
    android:paddingBottom="16dp"
    android:paddingTop="24dp">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="📦 ORDERS PENDING PROCESSING (WMS):"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#000000"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚪 LOG OUT"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="8dp"
            android:layout_marginRight="4dp" />

        <TextView
            android:id="@+id/txtSelectedOrder"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="No order selected yet - Please tap to select below!"
            android:textSize="13sp"
            android:textColor="#FF8800"
            android:textStyle="bold"
            android:paddingEnd="4dp" />

        <Button
            android:id="@+id/btnReload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄 RELOAD"
            android:textSize="11sp"
            android:textStyle="bold"
            android:backgroundTint="#4CAF50"
            android:textColor="#FFFFFF"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:padding="8dp" />
    </LinearLayout>

    <ListView
        android:id="@+id/listViewOrders"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="#CCCCCC"
        android:dividerHeight="1dp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTabOverview"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📦 OVERVIEW"
            android:backgroundTint="#0084FF"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginRight="4dp"/>

        <Button
            android:id="@+id/btnTabLogs"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="📜 WAREHOUSE LOG"
            android:backgroundTint="#7F8C8D"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginLeft="4dp"/>
    </LinearLayout>

</LinearLayout>