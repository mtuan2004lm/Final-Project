<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#FDFDFD">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- MỚI: Nút quay lại đặt ngay đầu màn hình, để không phải cuộn xuống hết
             mới thấy nút "QUAY VỀ DANH SÁCH SƠ ĐỒ" ở cuối như trước đây. -->
        <Button
            android:id="@+id/btnBackTop"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="← Back"
            android:textAllCaps="false"
            android:backgroundTint="#555555"
            android:textColor="#FFFFFF"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txtDetailTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WMS PACKAGE DETAIL INFORMATION"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="#111111"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/txtDetailInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textColor="#444444"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtDetailLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#0275D8"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/txtDetailCondition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#D9534F"
            android:layout_marginBottom="16dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🖼️ Package image at creation (OMS):"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
        <ImageView
            android:id="@+id/imgProductInitial"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="centerInside"
            android:background="#F5F5F5"
            android:layout_marginBottom="16dp"
            android:src="@android:drawable/ic_menu_gallery"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📸 Damage condition photo at the yard (WMS):"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>
        <ImageView
            android:id="@+id/imgProductDamage"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:scaleType="centerInside"
            android:background="#F5F5F5"
            android:layout_marginBottom="20dp"
            android:src="@android:drawable/ic_menu_report_image"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#EEEEEE"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⌨️ Manually enter the package barcode to verify:"
            android:textStyle="bold"
            android:textColor="#F0AD4E"
            android:layout_marginBottom="6dp"/>

        <EditText
            android:id="@+id/edtBarcodeInput"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Enter the correct format: PKG-600xx"
            android:inputType="textCapCharacters"
            android:background="@android:drawable/edit_text"
            android:padding="10dp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnConfirmScan"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="CONFIRM WAREHOUSE INTAKE"
            android:backgroundTint="#5CB85C"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Nút quay lại màn hình danh sách (giữ nguyên, phòng khi người dùng đã cuộn xuống cuối) -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="BACK TO LIST"
            android:backgroundTint="#777777"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</ScrollView>